# Server
PORT=8080

# MySQL DSN — same credentials in two formats, because each consumer expects its own.
# App (go-sql-driver/mysql) — no scheme prefix; needs parseTime=true for DATE/TIMESTAMP:
APP_DATABASE_DSN=tracker:tracker@tcp(127.0.0.1:3306)/tracker?parseTime=true&multiStatements=true
# golang-migrate CLI — URL form with mysql:// scheme:
MIGRATION_DATABASE_URL=mysql://tracker:tracker@tcp(127.0.0.1:3306)/tracker?multiStatements=true

# Session secret (32+ random bytes, base64 or hex). Minimum 16 chars enforced.
SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in hours (default: 336 = 14 days)
SESSION_LIFETIME_HOURS=336

# Set true behind HTTPS so the session cookie carries the Secure flag.
SECURE_COOKIES=false

# Absolute public URL used in password reset emails.
APP_BASE_URL=http://localhost:8080

# Upload directory (default to web/static/avatars)
#APP_AVATAR_DIR=

# SMTP settings for password reset emails. TLS mode: starttls, implicit, or none.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS_MODE=none
